{
  "name": "adacms",
  "version": "1.0.0",
  "description": "Paws & Tails Pet Shop - Modern E-Commerce Store & Pet Care Portal",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "tsx src/seed/index.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p ${PORT:-3001}"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.47.0",
    "mysql2": "^3.24.4",
    "next": "16.3.3",
    "payload": "3.90.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "4.22.4",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
